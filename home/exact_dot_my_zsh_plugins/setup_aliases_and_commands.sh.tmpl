# Kept from ohmyzsh common-aliases, which we no longer load. directories.zsh
# defines these three too, but with different flags; pinning them here keeps
# `ll` and friends listing exactly what they always have.
alias l="ls -lFh"
alias la="ls -lAFh"
alias ll="ls -l"
alias grep="grep --color"

alias vim="nvim"
alias tf="terraform"
alias ide="tmux-ide-layout"
alias git="git-wrapper"
alias fabric="fabric-ai"
alias \?="noglob _websearch"
alias \?\?="noglob _askclaudequick"

{{ if eq .chezmoi.os "darwin" -}}
alias love="/Applications/love.app/Contents/MacOS/love"
{{ end }}

# Source all functions
for func_file in "${0:h}/functions/"*.sh; do
    source "$func_file"
done
