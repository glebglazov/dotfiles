# mise shims must precede Homebrew: mise activate only runs in interactive
# shells, so without this a script or agent shell resolves `node` to Homebrew's
# and every native module built against mise's Node fails to load.
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"

{{ if eq .chezmoi.os "darwin" -}}
export BREW_PREFIX=/opt/homebrew/opt
export DOCKER_CONTEXT=orbstack
{{ else -}}
export BREW_PREFIX=/home/linuxbrew/.linuxbrew/opt
{{ end -}}

export XDG_CONFIG_DIRS=$HOME/.local/share
export XDG_CONFIG_HOME=$HOME/.config

export OP_ACCOUNT=DDLQGO2FFVEQHAR5L2CWZUCIJY

export GOPATH=$HOME/Dev/go
export GO111MODULE=on

export DISABLE_AUTO_UPDATE=true

export EDITOR="raw-vim"
export PAGER=ov

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

export GITHUB_USER=glebglazov
{{- if or .work .personal }}
export GH_TOKEN="{{ .githubWorkTokenBase }}token"
export GITHUB_TOKEN="{{ .githubWorkTokenBase }}token"
{{- end }}

export RIPGREP_CONFIG_PATH=$HOME/.config/ripgrep/config

export TMUX_FOLDERS_SEARCH_PATHS="~ ~/Dev ~/Dev/random ~/.local/share"

export HOMEBREW_NO_AUTO_UPDATE=1

