#!/bin/bash

set -eufo pipefail

# A fork branch, not upstream: every `op://` secret here is resolved through
# op-cache, and that needs the vault-to-account mapping which is not merged
# upstream yet. Falling back to upstream would silently install a build that
# resolves references against one account only.
OP_CACHE_REPO="https://github.com/glebglazov/op-cache"

# A commit, not a branch, so the installed binary matches something reviewable.
# Bumping this SHA is what makes chezmoi rebuild.
OP_CACHE_REV="b026923d30a9fac9f082ad5f9af66087ed7c0820"

{{ if lookPath "cargo" -}}
echo "Installing op-cache @ ${OP_CACHE_REV} from $OP_CACHE_REPO ..."

# --root puts the binary in ~/.local/bin, which set_path.sh already exports,
# instead of ~/.cargo/bin which nothing here adds to PATH.
cargo install \
  --git "$OP_CACHE_REPO" \
  --rev "$OP_CACHE_REV" \
  --locked \
  --root "{{ .chezmoi.homeDir }}/.local" \
  op-cache

"{{ .chezmoi.homeDir }}/.local/bin/op-cache" --version
{{ else -}}
echo "cargo is not on PATH — skipping op-cache." >&2
echo "Install a Rust toolchain (mise install rust) and run chezmoi apply again." >&2
{{ end -}}
