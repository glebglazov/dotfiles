#!/usr/bin/env python3
"""Runs merge-signals on a small Rails repository with one change, and checks
each fact it prints. Usage: test-merge-signals"""
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

SCRIPT = Path(__file__).resolve().parent / "merge-signals"
if not SCRIPT.exists():  # in the chezmoi source, the file has its prefix
    SCRIPT = SCRIPT.with_name("executable_merge-signals")


def sh(cwd, *cmd):
    subprocess.run(cmd, cwd=cwd, check=True, capture_output=True)


def write(root, path, text):
    p = root / path
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text)


with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    home, repo = tmp / "home", tmp / "shop"
    repo.mkdir()
    env = {**os.environ, "HOME": str(home), "GIT_CONFIG_GLOBAL": "/dev/null",
           "GIT_AUTHOR_NAME": "a", "GIT_COMMITTER_NAME": "a",
           "GIT_AUTHOR_EMAIL": "dev@example.com", "GIT_COMMITTER_EMAIL": "dev@example.com"}
    os.environ.update(env)

    sh(repo, "git", "init", "-q", "-b", "main")
    sh(repo, "git", "config", "user.email", "dev@example.com")
    sh(repo, "git", "remote", "add", "origin", "git@github.com:acme/shop.git")
    write(repo, "Gemfile", "source 'https://rubygems.org'\n")
    write(repo, "config/application.rb", "module Shop; end\n")
    write(repo, "app/models/user.rb", "class User\nend\n")
    write(repo, ".gitignore", "coverage/\n")
    write(repo, ".github/CODEOWNERS", "* @acme/devs\n/app/services/payments/ @acme/payments\n")
    sh(repo, "git", "add", ".")
    sh(repo, "git", "commit", "-qm", "base")

    sh(repo, "git", "checkout", "-qb", "feature")
    write(repo, "app/models/user.rb", "class User\n  def admin?\n    false\n  end\nend\n")
    write(repo, "db/migrate/20261128_drop_legacy_id.rb", "class DropLegacyId; end\n")
    write(repo, "app/services/payments/charge.rb", "class Charge\nend\n")
    write(repo, "spec/models/user_spec.rb", "describe User\n")
    write(repo, "README.md", "shop\n")
    write(repo, "Gemfile.lock", "GEM\n")
    sh(repo, "git", "add", ".")
    sh(repo, "git", "commit", "-qm", "change")
    # Work that is not committed is not part of the PR.
    write(repo, "app/models/user.rb", "class User\n  def admin?\n    true\n  end\nend\n")
    write(repo, "config/secrets.yml", "key: x\n")
    write(repo, "config/application.rb", "module Shop; class App; end; end\n")
    # Lines 2 and 3 of user.rb are covered, line 4 is not.
    write(repo, "coverage/lcov.info", f"SF:{repo / 'app/models/user.rb'}\nDA:1,1\nDA:2,3\nDA:3,3\nDA:4,0\nend_of_record\n")
    write(home, ".config/merge-signals/acme/shop.toml", '[[sensitive]]\nkind = "payments"\npaths = ["app/services/payments/*"]\n')

    out = subprocess.run([sys.executable, str(SCRIPT), "--base", "main"], cwd=repo, capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"merge-signals failed:\n{out.stderr}")
    got = json.loads(out.stdout)

kinds = {s["path"]: s["kinds"] for s in got["sensitive"]}
owners = {o["path"]: o["codeowners"] for o in got["owners"]["paths"]}
checks = [
    ("size counts the committed files only", got["size"]["files"] == 6),
    ("an uncommitted edit to a tracked file is not counted", "config/application.rb" not in kinds),
    ("an untracked file is not counted", "config/secrets.yml" not in kinds and "config/secrets.yml" not in got["tests"]["source"]),
    ("the Rails migration is a migration", kinds.get("db/migrate/20261128_drop_legacy_id.rb") == ["migration"]),
    ("the lockfile is a dependency", kinds.get("Gemfile.lock") == ["dependency"]),
    ("the local file adds payments", kinds.get("app/services/payments/charge.rb") == ["payments"]),
    ("a plain model is not sensitive", "app/models/user.rb" not in kinds),
    ("rails is detected", got["patterns"]["frameworks"] == ["rails"]),
    ("the local file is named", got["patterns"]["local_file"].endswith("merge-signals/acme/shop.toml")),
    ("the spec is a test", got["tests"]["test"] == ["spec/models/user_spec.rb"]),
    ("README is neither source nor test", "README.md" not in got["tests"]["source"]),
    ("line 4 of user.rb is uncovered", got["coverage"]["uncovered_lines"] == {"app/models/user.rb": [4]}),
    ("charge.rb is not in the report", "app/services/payments/charge.rb" in got["coverage"]["files_not_in_report"]),
    ("the last CODEOWNERS rule wins", owners["app/services/payments/charge.rb"] == ["@acme/payments"]),
    ("other paths get the catch-all owner", owners["app/models/user.rb"] == ["@acme/devs"]),
    ("checks without a GitHub PR are not a pass", got["checks"]["state"] in ("no-pr", "unknown")),
]
failed = [name for name, ok in checks if not ok]
for name, ok in checks:
    print(("ok   " if ok else "FAIL ") + name)
if failed:
    print(json.dumps(got, indent=2))
    sys.exit(1)
