#!/usr/bin/env bash
# Apply tmux pane border colors based on macOS light/dark appearance.
# Dark mode keeps the original look (subtle gray border, cyan active border).
# Light mode lifts the inactive border off the beige bg and uses a vivid
# orange active border so the focused pane is unmistakable.
set -euo pipefail

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then
  border=colour238
  active='fg=colour31,bg=default'
  background='#1d2021' # Ghostty theme "Gruvbox Dark Hard"
else
  border=colour243
  active='fg=colour208,bg=default,bold'
  background='#fbf1c7' # Ghostty theme "Gruvbox Light"
fi

tmux set -g pane-border-style "fg=${border},bg=default"
tmux set -g pane-active-border-style "${active}"

# Claude Code, Codex and nvim pick light or dark colors from the reply to an
# OSC 11 background query. tmux answers it from a window's window-style, else
# from any client attached to a session that has the window, else not at all.
# So a window no client can reach gets window-style with the Ghostty
# background, and every other window has none: tmux then answers with the
# client's own background and paints nothing, so a terminal with another
# theme (Blink) keeps it. Keep these colors in step with ghostty/shared.
reachable=$(tmux list-clients -F '#{?client_control_mode,,#{session_id}}' | tr '\n' ' ')
tmux list-windows -a -F '#{window_id} #{session_id}' |
  awk -v reachable="$reachable" -v style="bg=${background}" '
    BEGIN { n = split(reachable, s, " "); for (i = 1; i <= n; i++) seen[s[i]] = 1 }
    { if ($2 in seen) shown[$1] = 1; else if (!($1 in shown)) shown[$1] = 0 }
    END {
      for (w in shown)
        if (shown[w]) printf "set -wu -t %s window-style\n", w
        else printf "set -w -t %s window-style \"%s\"\n", w, style
    }' |
  tmux source-file -

# Ghostty's light/dark theme switch can leave the cursor color from the
# previous theme while inside tmux. The theme hooks name the client that
# switched; reset its cursor on its own terminal, so the terminal re-applies
# its theme's cursor. Never through a pane: a write there lands in the middle
# of whatever the pane is printing, and splits an image Claude Code is sending
# into raw base64 on screen.
target_client=${1:-}
if [[ -n "$target_client" ]]; then
  client_tty=$(tmux display-message -p -c "$target_client" '#{client_tty}' 2>/dev/null || true)
  if [[ -n "$client_tty" && -w "$client_tty" ]]; then
    printf '\033]112\007' >"$client_tty"
  fi
fi
