#!/usr/bin/env bash
# Apply tmux pane border colors based on macOS light/dark appearance.
# Dark mode keeps the original look (subtle gray border, cyan active border).
# Light mode lifts the inactive border off the beige bg and uses a vivid
# orange active border so the focused pane is unmistakable.
set -euo pipefail

# Which runs report (see below): every run, except two kinds.
# --no-report: a session or window came or went. A new pane has no report,
#   and the global window-style answers it.
# --client <name>: a client attached, detached or changed session.
#   - The script's own reporting client: skip, or the runs never stop. While
#     attached it shows its flags; after it detaches, only its name, which its
#     first command saved as an option of its own. Each such client fires
#     three hooks, so the option stays until a later run removes it.
#   - Another control client (Muxify Mobile): no report, because it reports
#     its own colors and must not be overwritten while it is in use.
report=true
case ${1:-} in
--no-report) report=false; shift ;;
--client)
  # With the client gone, -c falls back to another client: check the name.
  flags=$(tmux display-message -p -c "${2:-}" '#{client_name} #{client_flags}' 2>/dev/null || true)
  [[ ${flags%% *} == "${2:-}" ]] && flags=${flags#* } || flags=
  case $flags in *control-mode*read-only*) exit 0 ;; *control-mode*) report=false ;; esac
  [[ -z $flags && -n $(tmux show -gv "@tmux-theme-reporter-${2:-}" 2>/dev/null) ]] && exit 0
  set -- "${@:3}"
  ;;
esac

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then
  border=colour238
  active='fg=colour31,bg=default'
  background='#1d2021' # Ghostty theme "Gruvbox Dark Hard"
else
  border=colour243
  active='fg=colour208,bg=default,bold'
  background='#fbf1c7' # Ghostty theme "Gruvbox Light"
fi

tmux set -g pane-border-style "fg=${border},bg=default"
tmux set -g pane-active-border-style "${active}"

# Claude Code, Codex and nvim pick light or dark colors from the reply to an
# OSC 11 background query. tmux answers it from the pane's last color report,
# else from the window-style background, else from the client that shows the
# window's session. The Ghostty background is the global window-style, so a
# new window answers from its first moment: a program there asks before the
# hooks run this script, and with no answer it picks dark. A shown window gets
# `default`, so with no report tmux answers with the client's own background.
# Keep these colors in step with ghostty/shared.
style="bg=${background}"
tmux set -g window-style "$style"

# A report (`refresh-client -r`, from a control client) beats both, and one
# pane holds only the last report written. tmux drops it only when no control
# client is left, and Muxify's own listener (muxify-watch) is always attached.
# So a report from Muxify Mobile outlives the phone, and the screen in use
# must write last: a run reports each pane again, with the
# color of the terminal that shows it (Gruvbox of its light or dark kind) or
# the Ghostty background. tmux sends the mode 2031 notice (`ESC[?997;1n` or
# `;2n`) only to a pane it last told the other kind, so a pane that is already
# right does not repaint.
osc11() { echo "rgb:${1:1:2}${1:1:2}/${1:3:2}${1:3:2}/${1:5:2}${1:5:2}"; }
plan=$({
  tmux list-clients -F 'client #{client_control_mode} #{session_id} #{client_theme}'
  tmux list-panes -a -F 'pane #{window_id} #{session_id} #{pane_id}'
} | awk -v mac="$background" '
    $1 == "client" && $2 == 0 && !($3 in kind) { kind[$3] = $4 }
    $1 == "pane" {
      w = $2; if (!(w in colour)) colour[w] = ""
      if ($3 in kind && colour[w] == "")
        colour[w] = kind[$3] == "light" ? "#fbf1c7" : kind[$3] == "dark" ? "#1d2021" : mac
      panes[w] = panes[w] " " $4
    }
    END {
      for (w in colour) {
        if (colour[w] != "") printf "set -w -t %s window-style default\n", w
        else printf "set -wu -t %s window-style\n", w
        m = split(panes[w], p, " ")
        for (i = 1; i <= m; i++)
          if (!(p[i] in told)) { told[p[i]] = 1; print "report " p[i] " " (colour[w] != "" ? colour[w] : mac) }
      }
    }')
grep -v '^report ' <<<"$plan" | tmux source-file -

# Its first command marks this control client as the script's own, so its
# attach and detach start no new round (see --client above).
reports=$(sed -n 's/^report //p' <<<"$plan")
if [[ -n "$reports" && $report == true ]]; then
  now=$(date +%s)
  tmux show -g | awk -v now="$now" '/^@tmux-theme-reporter-/ && now - $2 > 60 { print "set -gu " $1 }' |
    tmux source-file -
  {
    echo "set -gF \"@tmux-theme-reporter-#{client_name}\" $now"
    while read -r pane colour; do
      printf 'refresh-client -r "%s:\\033]11;%s\\033\\\\"\n' "$pane" "$(osc11 "$colour")"
    done <<<"$reports"
  } | tmux -C attach -t "${reports%% *}" -f no-output,ignore-size,read-only >/dev/null
fi

# Ghostty's light/dark theme switch can leave the cursor color from the
# previous theme while inside tmux. The theme hooks name the client that
# switched; reset its cursor on its own terminal, so the terminal re-applies
# its theme's cursor. Never through a pane: a write there lands in the middle
# of whatever the pane is printing, and splits an image Claude Code is sending
# into raw base64 on screen.
target_client=${1:-}
if [[ -n "$target_client" ]]; then
  client_tty=$(tmux display-message -p -c "$target_client" '#{client_tty}' 2>/dev/null || true)
  if [[ -n "$client_tty" && -w "$client_tty" ]]; then
    printf '\033]112\007' >"$client_tty"
  fi
fi
