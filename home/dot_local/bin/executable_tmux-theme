#!/usr/bin/env bash
# Apply tmux pane border colors based on macOS light/dark appearance.
# Dark mode keeps the original look (subtle gray border, cyan active border).
# Light mode lifts the inactive border off the beige bg and uses a vivid
# orange active border so the focused pane is unmistakable.
set -euo pipefail

# --detached <client>: the client-detached hook. The report then runs even
# with no color change, unless the client was this script's own reporter.
refresh=false
if [[ ${1:-} == --detached ]]; then
  [[ ${2:-} == "$(tmux show -gv @tmux-theme-reporter 2>/dev/null)" ]] || refresh=true
  set -- "${@:3}"
fi

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then
  border=colour238
  active='fg=colour31,bg=default'
  background='#1d2021' # Ghostty theme "Gruvbox Dark Hard"
else
  border=colour243
  active='fg=colour208,bg=default,bold'
  background='#fbf1c7' # Ghostty theme "Gruvbox Light"
fi

tmux set -g pane-border-style "fg=${border},bg=default"
tmux set -g pane-active-border-style "${active}"

# Claude Code, Codex and nvim pick light or dark colors from the reply to an
# OSC 11 background query. tmux answers it from the window-style background,
# else from the client attached to the window's session. The Ghostty
# background is the global window-style, so a window no client shows answers
# from its first moment: a program in a new window asks before the hooks run
# this script, and with no answer it picks dark. A shown window gets
# `default`, so tmux answers with the client's own background and paints
# nothing, and a terminal with another theme (Blink) keeps it. Keep these
# colors in step with ghostty/shared.
style="bg=${background}"
previous=$(tmux show -gv window-style)
tmux set -g window-style "$style"
reachable=$(tmux list-clients -F '#{?client_control_mode,,#{session_id}}' | tr '\n' ' ')
plan=$(tmux list-panes -a -F '#{window_id} #{session_id} #{pane_id}' |
  awk -v reachable="$reachable" '
    BEGIN { n = split(reachable, s, " "); for (i = 1; i <= n; i++) seen[s[i]] = 1 }
    {
      if ($2 in seen) shown[$1] = 1; else if (!($1 in shown)) shown[$1] = 0
      panes[$1] = panes[$1] " " $3
    }
    END {
      for (w in shown)
        if (shown[w]) printf "set -w -t %s window-style default\n", w
        else {
          printf "set -wu -t %s window-style\n", w
          m = split(panes[w], p, " ")
          for (i = 1; i <= m; i++) if (!(p[i] in told)) { told[p[i]] = 1; print "report " p[i] }
        }
    }')
grep -v '^report ' <<<"$plan" | tmux source-file -

# A program that turned on mode 2031 hears of a light/dark switch as
# `ESC[?997;1n` or `;2n`. tmux sends it to the panes of a client whose theme
# changed, and not reliably because window-style changed (with any normal
# client attached, a new window-style sends nothing). So when the color changes,
# or a control client detaches and tmux drops its report (Muxify Mobile
# reports the phone's colors), a short-lived control client reports the color
# to every pane no client shows. tmux sends the notice only to a pane it last
# told the other color, so a pane that is already right gets nothing.
# `refresh-client -r` works only from a control client. Its first command
# names it in @tmux-theme-reporter, so its own detach starts no new round.
reports=$(sed -n 's/^report //p' <<<"$plan")
if [[ -n "$reports" ]] && [[ "$previous" != "$style" || $refresh == true ]]; then
  osc11="rgb:${background:1:2}${background:1:2}/${background:3:2}${background:3:2}/${background:5:2}${background:5:2}"
  {
    echo 'set -gF @tmux-theme-reporter "#{client_name}"'
    while read -r pane; do
      printf 'refresh-client -r "%s:\\033]11;%s\\033\\\\"\n' "$pane" "$osc11"
    done <<<"$reports"
  } | tmux -C attach -t "${reports%%$'\n'*}" -f no-output,ignore-size,read-only >/dev/null
fi

# Ghostty's light/dark theme switch can leave the cursor color from the
# previous theme while inside tmux. The theme hooks name the client that
# switched; reset its cursor on its own terminal, so the terminal re-applies
# its theme's cursor. Never through a pane: a write there lands in the middle
# of whatever the pane is printing, and splits an image Claude Code is sending
# into raw base64 on screen.
target_client=${1:-}
if [[ -n "$target_client" ]]; then
  client_tty=$(tmux display-message -p -c "$target_client" '#{client_tty}' 2>/dev/null || true)
  if [[ -n "$client_tty" && -w "$client_tty" ]]; then
    printf '\033]112\007' >"$client_tty"
  fi
fi
