includes = [
    "~/private/.config/pop/config.toml",
    "~/private/.config/pop/workbenches.toml"
]

projects = [
    { path = "~/.local/share/chezmoi" },
    { path = "~/Dev/*/*" },
    { path = "~/Dev/mixed/obsidian_vaults/*", display_depth = 2 }
]

[integrations]
skills_prefix = ""

[[commands]]
key = "ctrl+o"
label = "dev o"
command = "$SHELL -ic 'dev o'"
exit = true

[dashboard]
# current_pane_always_under_cursor = true
cursor_position = "current_any"
sort_criteria = ["status", "pane_last_active_at", "alphabetical"]

[pane_monitoring]
tcp_server = true
ignore_status_from = ["tmux-global"]
topic_agents = [
    { type = "truncate", set_if = "empty" },
    { type = "agent", command = "ollama:gemma4:e4b", set_if = "empty_or_seed", timeout = 60 }
]

[[worktree.commands]]
key = "ctrl+l"
label = "cleanup"
command = "tmux-branch-cleanup"
exit = true

[work.implement]
{{- if .work }}
agents = ["claude", "codex", "kimi"]
{{- else }}
agents = ["cursor", "pi", "claude"]
{{- end }}

[work.verify]
enabled = true
{{- if .work }}
agents = ["claude --model opus --effort xhigh", "codex --model gpt-5.6-sol", "kimi --model moonshot-ai/kimi-k3"]
{{- else }}
agents = ["cursor-agent --model claude-opus-5-thinking-high", "claude --model opus --effort high", "pi --model opencode-go/kimi-k3"]
{{- end }}

# A review reaches no verdict and spawns no work — it writes a document into
# task storage after the verify phase. Effort is left implicit: heavy.
[work.review]
enabled = true
{{- if .work }}
agents = ["claude --model opus --effort xhigh", "codex --model gpt-5.6-sol", "kimi --model moonshot-ai/kimi-k3"]
{{- else }}
agents = ["cursor-agent --model claude-opus-5-thinking-high", "claude --model opus --effort high", "pi --model opencode-go/kimi-k3"]
{{- end }}

[work.routine]
{{- if .work }}
agents = ["claude", "codex", "kimi"]
{{- else }}
agents = ["claude", "pi", "cursor"]
{{- end }}

# Attended entries are the whole invocation: the cmd reaches the launched
# agent as written, and display_name is what pop calls it in a pane title,
# an action-menu row and the override picker. A bare string is sugar for a
# cmd with no display name, and pins no model — the agent decides.
[work.attended]
{{- if .work }}
agents = [
    { display_name = "Claude Opus", cmd = "claude --model opus" },
    { display_name = "Codex Sol", cmd = "codex --model gpt-5.6-sol" },
    "kimi",
    "claude",
]
{{- else }}
agents = [
    { display_name = "Claude Opus", cmd = "claude --model opus" },
    { display_name = "Cursor Opus", cmd = "cursor --model claude-opus-5-thinking-high" },
    "pi",
]
{{- end }}

{{ if .work -}}
[effort.claude]
heavy = [{ model = "opus", reasoning = "high" }]
standard = [{ model = "opus", reasoning = "medium" }]
light = [{ model = "sonnet", reasoning = "high" }]
{{ else }}
[effort.claude]
heavy = [{ model = "opus", reasoning = "medium" }]
standard = [{ model = "opus", reasoning = "low" }]
light = [{ model = "haiku", reasoning = "high" }]
{{ end }}

[effort.codex]
heavy = [{ model = "gpt-5.6-sol", reasoning = "xhigh" }]
standard = [{ model = "gpt-5.6-sol", reasoning = "medium" }]
light = [{ model = "gpt-5.6-terra", reasoning = "low" }]

[effort.kimi]
heavy = [{ model = "moonshot-ai/kimi-k3", reasoning = "high" }]
standard = [{ model = "moonshot-ai/kimi-k3", reasoning = "low" }]
light = [{ model = "moonshot-ai/kimi-k2.7-code-highspeed" }]

[effort.pi]
heavy = [{ model = "opencode-go/kimi-k3" }]
standard = [{ model = "opencode-go/deepseek-v4-flash" }]
light = [{ model = "opencode-go/kimi-k2.7-code" }]

# Cursor encodes reasoning in the model name (ADR-0066), so a tier is a bare
# token. Heads are all Anthropic on purpose: one vendor allowance gates every
# tier, so exhausting it is a single observable event rather than three. The
# grok/composer tails are cursor-branded models that allowance does not gate —
# the floor that still runs once the vendor is spent.
# Tail entries are inert until the intra-tier model skip ships (ADR-0168).
[effort.cursor]
heavy = [{ model = "claude-opus-5-thinking-medium" }, { model = "cursor-grok-4.5-high" }, { model = "composer-2.5" }]
standard = [{ model = "claude-opus-5-thinking-low" }, { model = "cursor-grok-4.5-medium" }, { model = "composer-2.5" }]
light = [{ model = "claude-sonnet-5-thinking-high" }, { model = "composer-2.5-fast" }]
