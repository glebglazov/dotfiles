{{- /* 1Password holds the client as Google downloads it; gog reads only a flat client_id/client_secret pair from this file. */ -}}
{{- $client := (onepasswordRead "op://Private/Google MCP OAuth app credentials/password" | fromJson).installed -}}
{{ dict "client_id" $client.client_id "client_secret" $client.client_secret | toPrettyJson }}
