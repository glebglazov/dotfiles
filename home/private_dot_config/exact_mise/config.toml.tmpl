[settings]
trusted_config_paths = [
  '~/private/Dev',
  '~/.config/mise/config.toml'
]
idiomatic_version_file_enable_tools = ["ruby"]

[tools]
rust      = '1.91.0'
go        = '1.24'
nodejs    = '24'
bun       = '1'
pnpm      = '10'
ruby      = '4.0.5'
yarn      = '4.9'
python    = '3.13'
terraform = '1.12'
opentofu  = '1.12'
java      = '24.0'
erlang    = '28.0'
elixir    = '1.18'
uv          = '0.8'
lua         = '5.4'
tree-sitter = '0.26'
"npm:@earendil-works/pi-coding-agent" = 'latest'
"npm:@tobilu/qmd" = 'latest'
"npm:pi-opencode-bridge" = "latest"
"npm:openai" = "latest"
{{- /* Tools listed in the private submodule's .chezmoidata. Absent on a clone
       made without --recurse-submodules, so guard the key. */}}
{{- $private := dict }}
{{- if hasKey . "private_packages" }}{{ $private = .private_packages }}{{ end }}
{{- range dig "mise" (list) $private }}
{{- if kindIs "string" . }}
"{{ . }}" = 'latest'
{{- else }}
"{{ .tool }}" = { version = 'latest', trust_policy_excludes = [{{ range $i, $e := .excludes }}{{ if $i }}, {{ end }}'{{ $e }}'{{ end }}] }
{{- end }}
{{- end }}

[settings.ruby]
ruby_build_opts = "--enable-yjit"
